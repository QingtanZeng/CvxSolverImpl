{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(lldb) Debug tst_AMD",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build_debug/tst_AMD",
            "args": [],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "terminal": "integrated",
            "preLaunchTask": "CMake Build tst_AMD"
        },
        {
            "name": "(lldb) Debug ECOSTest01",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build_debug/ECOSTest01",
            "args": [],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "terminal": "integrated",
            "preLaunchTask": "CMake Build ECOSTest01"
        },
        {
            "type": "julia",
            "name": "Run Julia File with Debugger",
            "request": "launch",
            "program": "${file}",
            "stopOnEntry": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Attach to Julia Process (LLDB)",
            "type": "lldb",
            "request": "attach",
            "program": "/usr/local/bin/julia",
            "processId": "${command:pickProcess}",
            "sourceFileMap": {
                "/home/zengqt/Projects_WSL/CvxSolverImpl/ecos_test/src": "${workspaceFolder}/ecos_test/src"
            }
        }
    ]
