{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Debug ECOSTest01",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/ECOSTest01",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake Build ECOSTest01"
        },
        {
            "type": "julia",
            "name": "Run Julia File with Debugger",
            "request": "launch",
            "program": "${file}",
            "stopOnEntry": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Attach to Julia Process (GDB)",
            "type": "lldb",
            "request": "attach",
            "program": "/usr/local/bin/julia",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "sourceFileMap": {
                "/home/zengqt/Projects_WSL/CvxSolverImpl/ecos_test/src": "${workspaceFolder}/ecos_test/src"
            }
        }
    ]
}
