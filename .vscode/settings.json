{
    "workbench.colorTheme": "Visual Studio Light",
    "ROS2.distro": "jazzy",
    "python.autoComplete.extraPaths": [
        "/opt/ros/jazzy/lib/python3.12/site-packages"
    ],
    "python.analysis.extraPaths": [
        "/opt/ros/jazzy/lib/python3.12/site-packages"
    ],
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#86d084",
        "activityBar.background": "#86d084",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#7577ca",
        "activityBarBadge.foreground": "#e7e7e7",
        "commandCenter.border": "#15202b99",
        "sash.hoverBorder": "#86d084",
        "statusBar.background": "#62c25f",
        "statusBar.foreground": "#15202b",
        "statusBarItem.hoverBackground": "#45ac42",
        "statusBarItem.remoteBackground": "#62c25f",
        "statusBarItem.remoteForeground": "#15202b",
        "titleBar.activeBackground": "#62c25f",
        "titleBar.activeForeground": "#15202b",
        "titleBar.inactiveBackground": "#62c25f99",
        "titleBar.inactiveForeground": "#15202b99"
    },
    "peacock.remoteColor": "#62c25f",

    // CodeLLDB 与 LLVM 18 调试器配置
    "lldb.executable": "/usr/bin/lldb-18",
    "lldb-dap.executable-path": "/usr/bin/lldb-dap-18",

    // CMake 与 LLVM 18 工具链集成
    "cmake.buildDirectory": "${workspaceFolder}/build_debug",
    "cmake.configureSettings": {
        "CMAKE_C_COMPILER": "/usr/bin/clang-18",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-18",
        "CMAKE_CXX_STANDARD": "23"
    },

    // C/C++ 智能提示与标准配置 (LLVM 18 / C++23)
    "C_Cpp.default.compilerPath": "/usr/bin/clang++-18",
    "C_Cpp.default.cppStandard": "c++23",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.intelliSenseMode": "linux-clang-x64",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build_debug/compile_commands.json"
}
